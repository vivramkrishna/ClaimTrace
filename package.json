{
  "name": "pr-reality-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Graph-grounded evidence cards that compare a pull request's claim with the code it changes.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node scripts/check.js",
    "dev:offline": "node scripts/dev-offline.js",
    "test:core": "node --test \"test/core/**/*.test.js\"",
    "test:app": "node --test \"test/app/**/*.test.js\"",
    "graph:import": "bash scripts/import-graph.sh",
    "replay:warm": "node scripts/warm-cache.js",
    "preflight": "node scripts/preflight.js",
    "verify": "npm test && npm run preflight"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  }
}
